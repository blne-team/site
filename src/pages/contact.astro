---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { useTranslations } from '../i18n/utils';

const t = useTranslations('zh-cn');
---

<Layout title={t('contact.title')}>
	<Nav />
	<main class="container section">
		<h1 class="display-hero">{t('contact.title')}</h1>
    <p class="hero-subtitle">{t('contact.subtitle')}</p>
    <div class="card" style="margin-top: 4rem; max-width: 600px;">
      <form style="display: flex; flex-direction: column; gap: 1.5rem;">
        <input type="text" placeholder="姓名" style="padding: 1rem; border: 1px solid var(--border-gray); border-radius: var(--radius-button);" />
        <input type="email" placeholder="邮箱" style="padding: 1rem; border: 1px solid var(--border-gray); border-radius: var(--radius-button);" />
        <textarea placeholder="消息" rows="5" style="padding: 1rem; border: 1px solid var(--border-gray); border-radius: var(--radius-button);"></textarea>
        <button type="submit" class="btn btn-primary">发送消息</button>
      </form>
    </div>
	</main>
	<Footer />
</Layout>
