---
import { getLangFromUrl, useTranslations, getLocalizedPath, getRelativePath } from '../i18n/utils';
import { languages } from '../i18n/ui';
import { SITE } from '../site.config';
import logoImg from '../assets/favicon.svg';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<footer class="footer section">
  <div class="container">
    <div class="footer-card card">
      <div class="grid-12">
        <div class="footer-brand">
          <a href={getLocalizedPath('/', lang)} class="logo">
            <img src={logoImg.src} alt={t('site.name')} class="logo-img" width={32} height={32} />
            <span class="logo-text">{t('site.name')}</span>
          </a>
          <p class="footer-desc">{t('footer.description')}</p>
          
          <div class="footer-lang">
            <span class="uppercase-label">Region</span>
            <div class="lang-links">
              {Object.entries(languages).map(([code, name]) => (
                <a href={getRelativePath(Astro.url, code)} class={lang === code ? 'active' : ''}>
                  {name}
                </a>
              ))}
            </div>
          </div>
        </div>

        <div class="footer-nav">
          <div class="footer-group">
            <span class="uppercase-label">{t('footer.product')}</span>
            <ul>
              <li><a href={getLocalizedPath('/#features', lang)}>{t('footer.features')}</a></li>
              <li><a href={getLocalizedPath('/#performance', lang)}>{t('footer.performance')}</a></li>
              <li><a href={getLocalizedPath('/products', lang)}>{t('nav.products')}</a></li>
            </ul>
          </div>
          <div class="footer-group">
            <span class="uppercase-label">{t('footer.company')}</span>
            <ul>
              <li><a href={getLocalizedPath('/about', lang)}>{t('footer.about')}</a></li>
              <li><a href={getLocalizedPath('/news', lang)}>{t('footer.blog')}</a></li>
              <li><a href={getLocalizedPath('/contact', lang)}>{t('footer.contact')}</a></li>
            </ul>
          </div>
          <div class="footer-group">
            <span class="uppercase-label">{t('footer.legal')}</span>
            <ul>
              <li><a href={getLocalizedPath('/privacy', lang)}>{t('footer.privacy')}</a></li>
              <li><a href={getLocalizedPath('/terms', lang)}>{t('footer.terms')}</a></li>
            </ul>
          </div>
        </div>
      </div>

      <div class="footer-bottom">
        <p>&copy; {new Date().getFullYear()} {SITE.companyName}. {t('footer.rights')}</p>
        <div class="social-links">
          <a href={SITE.social.twitter} aria-label="Twitter">TW</a>
          <a href={SITE.social.github} aria-label="GitHub">GH</a>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-bottom: 2rem;
  }
  .footer-card {
    padding: 3rem 1.5rem;
    border-radius: var(--radius-section);
  }

  @media (min-width: 768px) {
    .footer-card {
      padding: 4rem;
    }
  }

  .footer-brand {
    grid-column: span 1;
  }

  @media (min-width: 992px) {
    .footer-brand {
      grid-column: span 5;
    }
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
  }
  .logo-img {
    width: 32px;
    height: 32px;
    border-radius: 6px;
  }
  .logo-text {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--kraken-purple);
  }

  .footer-desc {
    margin-top: 1.5rem;
    margin-bottom: 2.5rem;
    color: var(--text-secondary);
    max-width: 300px;
  }

  .footer-lang {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .lang-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .lang-links a {
    text-decoration: none;
    font-size: 0.8125rem;
    color: var(--text-secondary);
  }

  .lang-links a.active {
    color: var(--text-primary);
    font-weight: 600;
  }

  .footer-nav {
    grid-column: span 1;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.5rem;
  }

  @media (min-width: 768px) {
    .footer-nav {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 992px) {
    .footer-nav {
      grid-column: span 7;
    }
  }

  .footer-group ul {
    list-style: none;
    margin-top: 1.5rem;
  }

  .footer-group li {
    margin-bottom: 0.75rem;
  }

  .footer-group a {
    text-decoration: none;
    color: var(--text-secondary);
    font-size: 0.94rem;
    transition: color 0.2s;
  }

  .footer-group a:hover {
    color: var(--kraken-purple);
  }

  .footer-bottom {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-gray);
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--text-secondary);
    font-size: 0.875rem;
  }

  .social-links {
    display: flex;
    gap: 1.5rem;
  }

  .social-links a {
    text-decoration: none;
    color: var(--text-primary);
    font-weight: 600;
  }
</style>
